# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Render: copy the "External Database URL" from your Render Postgres dashboard
# Neon/Supabase: use the connection pooler URL here
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Only needed if your provider uses a connection pooler (e.g. Supabase/Neon)
# If using Render Postgres directly, set DIRECT_URL = DATABASE_URL
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ── OpenAI ────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
# If left empty, AI features degrade gracefully (tickets still work)
OPENAI_API_KEY="sk-..."

# ── App URL ───────────────────────────────────────────────────────────────
# Set to your Render service URL after first deploy, e.g.:
# https://bookleaf-portal.onrender.com
NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"
